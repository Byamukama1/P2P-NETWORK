require("dotenv").config();

const express = require("express");
const cors = require("cors");
const Binance = require("binance-api-node").default;
const admin = require("firebase-admin");


const app = express();

app.use(cors());
app.use(express.json());


// ==========================
// Firebase Admin Connection
// ==========================

// Put your Firebase Admin JSON in Render Environment Variables
// as FIREBASE_SERVICE_ACCOUNT

const serviceAccount = JSON.parse(
  process.env.FIREBASE_SERVICE_ACCOUNT
);


admin.initializeApp({
  credential: admin.credential.cert(serviceAccount)
});


const db = admin.firestore();


// ==========================
// Binance Connection
// ==========================

const binance = Binance({

  apiKey: process.env.BINANCE_API_KEY,

  apiSecret: process.env.BINANCE_SECRET_KEY

});


// ==========================
// Create Firestore Collections
// ==========================

async function createCollections(){

const collections = [

"binanceBalances",

"binanceDeposits",

"binanceWithdrawals",

"binanceTransactions",

"systemLogs"

];


for(const name of collections){

await db.collection(name)
.doc("system")
.set({

collection:name,

createdAt:new Date()

},{merge:true});


}


console.log("Firestore collections ready");

}



// ==========================
// Sync Binance Balances
// ==========================

async function syncBalances(){

try{


const account = await binance.accountInfo();


for(const balance of account.balances){


if(
Number(balance.free) > 0 ||
Number(balance.locked) > 0
){


await db.collection("binanceBalances")
.doc(balance.asset)
.set({

coin:balance.asset,

free:balance.free,

locked:balance.locked,

updatedAt:new Date()

});


}


}


console.log("Balances synced");


}

catch(error){

console.log(
"Balance error:",
error.message
);

}

}




// ==========================
// Sync USDT Deposits
// ==========================

async function syncDeposits(){

try{


const result =
await binance.depositHistory({

coin:"USDT"

});


for(const item of result.depositList){


await db.collection("binanceDeposits")
.doc(item.txId)
.set({

coin:item.coin,

amount:item.amount,

network:item.network,

hash:item.txId,

status:item.status,

time:item.insertTime

});


}


console.log("Deposits synced");


}

catch(error){

console.log(
"Deposit error:",
error.message
);

}

}



// ==========================
// API Routes
// ==========================


app.get("/",(req,res)=>{

res.send(
"Binance Firebase Server Running"
);

});



app.get("/sync",async(req,res)=>{


await syncBalances();

await syncDeposits();


res.json({

success:true,

message:"Binance data synchronized"

});


});



app.get("/balances",async(req,res)=>{


const snapshot =
await db.collection("binanceBalances")
.get();


let data=[];


snapshot.forEach(doc=>{

if(doc.id!=="system")
data.push(doc.data());

});


res.json(data);


});



app.get("/transactions",async(req,res)=>{


const snapshot =
await db.collection("binanceDeposits")
.get();


let data=[];


snapshot.forEach(doc=>{

if(doc.id!=="system")
data.push(doc.data());

});


res.json(data);


});



// ==========================
// Start Server
// ==========================

const PORT =
process.env.PORT || 3000;


app.listen(PORT,()=>{

console.log(
`Server running on port ${PORT}`
);

});


// First setup
createCollections();